      "vm_name": "nimbus-postgresql-universidad",
      "created_at": "2026-05-24T20:01:02.1903851Z",
      "access_cmd": "psql -h 192.168.10.21 -U jhony -d universidad",
      "sql_content": "CREATE DATABASE universidad;\r\n\r\n\\c universidad;\r\n\r\nCREATE TABLE estudiantes (\r\n    id SERIAL PRIMARY KEY,\r\n    nombre VARCHAR(120) NOT NULL,\r\n    correo VARCHAR(120) UNIQUE NOT NULL,\r\n    fecha_registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP\r\n);\r\n\r\nCREATE TABLE profesores (\r\n    id SERIAL PRIMARY KEY,\r\n    nombre VARCHAR(120) NOT NULL,\r\n    departamento VARCHAR(100)\r\n);\r\n\r\nCREATE TABLE cursos (\r\n    id SERIAL PRIMARY KEY,\r\n    nombre VARCHAR(120) NOT NULL,\r\n    creditos INT NOT NULL,\r\n    profesor_id INT,\r\n    FOREIGN KEY (profesor_id) REFERENCES profesores(id)\r\n        ON DELETE SET NULL\r\n);\r\n\r\nCREATE TABLE matriculas (\r\n    id SERIAL PRIMARY KEY,\r\n    estudiante_id INT NOT NULL,\r\n    curso_id INT NOT NULL,\r\n    fecha_matricula TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\r\n    nota_final NUMERIC(4,2),\r\n    FOREIGN KEY (estudiante_id) REFERENCES estudiantes(id)\r\n        ON DELETE CASCADE,\r\n    FOREIGN KEY (curso_id) REFERENCES cursos(id)\r\n        ON DELETE CASCADE\r\n);\r\n\r\nINSERT INTO profesores (nombre, departamento)\r\nVALUES\r\n('Carlos Ramirez', 'Ingeniería'),\r\n('Laura Gómez', 'Matemáticas');\r\n\r\nINSERT INTO estudiantes (nombre, correo)\r\nVALUES\r\n('Juan Pérez', 'juan@correo.com'),\r\n('Ana Torres', 'ana@correo.com');\r\n\r\nINSERT INTO cursos (nombre, creditos, profesor_id)\r\nVALUES\r\n('Bases de Datos', 4, 1),\r\n('Álgebra Lineal', 3, 2);"
    },
